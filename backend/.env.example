# Copy to .env and fill in. `make dev` does the copy for you.
# Secret values are empty here on purpose; never commit a real .env.

APP_ENV=dev
LOG_LEVEL=INFO
# Comma separated. "*" is for local dev only.
CORS_ORIGINS=*

# ---- Postgres ----
POSTGRES_USER=pitchme
POSTGRES_PASSWORD=
POSTGRES_DB=pitchme
# Host port. Change it if 5432 is taken on your machine.
POSTGRES_PORT=5432
# Optional. When empty it is built from the POSTGRES_* values.
# postgresql+psycopg://<user>:<password>@localhost:5432/<db>
DATABASE_URL=

# ---- Object storage (MinIO locally, any S3 in production) ----
MINIO_ROOT_USER=pitchme
MINIO_ROOT_PASSWORD=
MEDIA_BUCKET=pitchme
# Host ports for MinIO. Keep S3_ENDPOINT in step with MINIO_PORT.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# How the backend reaches storage (same machine).
S3_ENDPOINT=http://localhost:9000
# Host the phone uses for presigned URLs. dev.sh sets it to your LAN IP.
S3_PUBLIC_ENDPOINT=
# Leave empty to use MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ---- Auth ----
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---- Agent worker callbacks ----
AI_CALLBACK_KEY=
SERVER_PUBLIC_BASE_URL=http://localhost:8000

# ---- LLM ----
# groq or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cap for one reply. Long structured replies need room.
LLM_MAX_OUTPUT_TOKENS=4096

# ---- Transcription and diarization ----
# groq (hosted) or local (faster-whisper)
TRANSCRIBE_PROVIDER=groq
WHISPER_MODEL=whisper-large-v3-turbo
# Used only when TRANSCRIBE_PROVIDER=local.
WHISPER_MODEL_SIZE=base
# auto, cpu or cuda.
WHISPER_DEVICE=auto
# Folder with the MediaPipe models (scripts/download_models.sh). Empty: ai/models.
VISION_MODELS_DIR=
DIARIZE_PROVIDER=pyannote
# Read token for the gated pyannote models on Hugging Face.
HF_TOKEN=

# ---- Voice cloning ----
# cartesia or resemble
VOICE_CLONE_PROVIDER=cartesia
CARTESIA_API_KEY=
# Emotion and speed only take effect on sonic-3 and later.
CARTESIA_MODEL=sonic-3
CARTESIA_LANGUAGE=en
RESEMBLE_API_KEY=

# ---- Redis (LiveKit and the analysis job queue) ----
REDIS_PORT=6379

# ---- Live call (LiveKit agent) ----
# Speech to text and text to speech for the AI buyer.
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOICE=aura-2-andromeda-en
# A call ends on its own after this many minutes.
REHEARSAL_MAX_MINUTES=20
# Health check port of the agent worker (8081 is Expo's).
AGENT_PORT=8082
# Warm job processes for the agent worker.
AGENT_IDLE_PROCESSES=2
LIVEKIT_URL=ws://localhost:7880
# URL the phone uses. dev.sh sets it to your LAN IP.
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=devkey
# At least 32 characters. The LiveKit server in docker-compose reads the same pair.
LIVEKIT_API_SECRET=
# Where egress uploads recordings, as seen by the egress service. Leave it
# empty to use the storage set in the egress config (docker-compose does this).
EGRESS_S3_ENDPOINT=

# ---- Local network (set by dev.sh) ----
LAN_IP=
MINIO_HOST=
